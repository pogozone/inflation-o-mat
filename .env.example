# Für Docker in .env kopieren und alle drei Platzhalter ändern.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_ROOT_PASSWORD=replace-with-another-database-password

# Optional: nur für die echte KI-Belegerkennung.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Bei lokalem HTTP false, bei öffentlichem HTTPS true.
COOKIE_SECURE=false

# Nur für den manuellen Start außerhalb Docker:
# DATABASE_URL=mysql+pymysql://inflation:password@127.0.0.1:3306/inflation?charset=utf8mb4
# Ohne DATABASE_URL: ausdrücklich SQLite für den lokalen Schnellstart.
